{
  "name": "artex-browser",
  "version": "1.0.0",
  "private": true,
  "description": "ARTEX Browser \u2014 the autonomous pentest loop running entirely in your browser. Paste an LLM key, give it an in-scope target, watch it work.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/test/*.test.ts",
    "verify": "npm run typecheck && npm run test && npm run build && npm run smoke",
    "smoke": "vite build --config vite.smoke.config.ts --logLevel warn && node .smoke/smoke.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
